  "info": {
    "description": "Local API for TiTiler COG Map Tiles: manage Cloud-Optimized GeoTIFF map layers stored in Backblaze B2 and serve dynamic XYZ tiles read straight from B2 by TiTiler. This contract documents the sample's own management API; the mounted TiTiler tile sub-app has its own schema and is not part of this contract.",
    "title": "TiTiler COG Map Tiles API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/files": {
      "get": {
        "operationId": "list_files_endpoint_files_get",
