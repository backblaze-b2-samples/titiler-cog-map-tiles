# Backblaze B2 (S3-compatible API) — required
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your-region

# Optional: public base URL for building object URLs on a PUBLIC bucket. The app
# runs fine without it (private buckets serve tiles/reads via the S3 API + GDAL).
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.your-region.backblazeb2.com

# The S3 endpoint is derived from B2_REGION as
#   https://s3.{B2_REGION}.backblazeb2.com
# and GDAL's tile-read path uses the same host. No endpoint URL is needed.

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=REPLACE_WITH_YOUR_B2_APPLICATION_KEY
# B2_BUCKET_NAME=my-cog-archive
# B2_REGION=us-west-005

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
